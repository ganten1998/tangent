# The Docker build context is the REPO ROOT — tools/tangent-fulfil depends on
# tangent-core by a relative path, so the context cannot be narrowed to that
# subdirectory. Docker does NOT honour .gitignore, so without this file every
# gitignored build artefact ships to the builder: tools/tangent-fulfil/target is
# ~130 MB of macOS objects, and `COPY tools/tangent-fulfil` would drop them into
# the Linux image on top of the build. Context goes 229 MB -> ~10 MB.
**/target
.git
.DS_Store
**/.DS_Store

# Not referenced by tools/tangent-fulfil/Dockerfile.
dist
assets
tests
tools/tangent-keygen

# Third-party SDKs and caches (the ASIO SDK may not be redistributed; the
# ffmpeg archives are 250 MB). Nothing in the fulfil image reads them.
vendor
