<?xml version="1.0" encoding="utf-8"?>
<!--
  The macOS installer's own UI.

  One package and one choice, the application, so there is nothing to
  customize: `customize="never"` installs it without showing a list of
  components to pick from.

  @VERSION@ and @TITLE@ are substituted by scripts/build-installer.sh; this
  file is not valid XML input to productbuild until it has been.
-->
<installer-gui-script minSpecVersion="2">
    <title>@TITLE@</title>
    <organization>com.ganten</organization>
    <options customize="never" require-scripts="false" hostArchitectures="arm64,x86_64"/>

    <!--
      Two destinations, not three.

      "For all users" is the default: /Applications, which needs a password
      because it is root-owned.

      "For me only" is ON, and was wrongly off. macOS relocates the absolute
      install-location under the home directory (verified by installing
      one), so the app lands in ~/Applications. It needs no password, and on
      a single-user Mac there is no reason to demand one.

      "On a specific disk" stays OFF: the welcome and conclusion pages name
      the two places above, and an install on another disk would be in
      neither of them.
    -->
    <domains enable_anywhere="false" enable_currentUserHome="true" enable_localSystem="true"/>

    <welcome file="welcome.html" mime-type="text/html"/>
    <license file="LICENSE.txt" mime-type="text/plain"/>
    <conclusion file="conclusion.html" mime-type="text/html"/>

    <choices-outline>
        <line choice="choice.standalone"/>
    </choices-outline>

    <choice id="choice.standalone"
            title="Tangent"
            description="The Tangent application."
            start_selected="true"
            visible="true">
        <pkg-ref id="com.ganten.tangent.app"/>
    </choice>

    <pkg-ref id="com.ganten.tangent.app" version="@VERSION@">Tangent-app.pkg</pkg-ref>
</installer-gui-script>
