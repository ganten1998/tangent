<?xml version="1.0" encoding="utf-8"?>
<!--
  The macOS installer's own UI.

  ONE choice now: the VST3 plugin is RETIRED (2026-08-24, the owner's
  ruling — Tangent is a DAW and does not load through another). The
  standalone is the product, and the installer says so plainly.

  @VERSION@ and @TITLE@ are substituted by scripts/build-installer.sh; this
  file is not valid XML input to productbuild until it has been.
-->
<installer-gui-script minSpecVersion="2">
    <title>@TITLE@</title>
    <organization>com.ganten</organization>
    <options customize="always" require-scripts="false" hostArchitectures="arm64,x86_64"/>

    <!--
      Two destinations, not three, and the two decisions are different.

      "For all users" is the default and what every other audio plugin on a
      typical Mac does: /Applications and /Library/Audio/Plug-Ins/VST3. Needs
      a password, because both are root-owned.

      "For me only" is ON, and was wrongly off. macOS relocates both absolute
      install-locations under the home directory — verified by installing one:
      the app lands in ~/Applications and the plugin in
      ~/Library/Audio/Plug-Ins/VST3, which is a VST3 specification search path
      that Reaper and every other host scans by default. It needs no password.
      On a single-user Mac there is no reason to demand one.

      "On a specific disk" stays OFF, and that one is not conservatism. It
      would put the plugin at /Volumes/Something/Library/Audio/Plug-Ins/VST3,
      which no host looks in — an install that succeeds and produces a plugin
      that cannot be found is worse than an option that is not offered.
    -->
    <domains enable_anywhere="false" enable_currentUserHome="true" enable_localSystem="true"/>

    <welcome file="welcome.html" mime-type="text/html"/>
    <license file="LICENSE.txt" mime-type="text/plain"/>
    <conclusion file="conclusion.html" mime-type="text/html"/>

    <choices-outline>
        <line choice="choice.standalone"/>
    </choices-outline>

    <choice id="choice.standalone"
            title="Tangent (application)"
            description="The standalone app, installed to /Applications. Opens its own window and connects to a MIDI keyboard by itself."
            start_selected="true"
            visible="true">
        <pkg-ref id="com.ganten.tangent.app"/>
    </choice>

    <pkg-ref id="com.ganten.tangent.app" version="@VERSION@">Tangent-app.pkg</pkg-ref>
</installer-gui-script>
