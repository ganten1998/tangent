#!/bin/sh
# The VST3 plugin was retired 2026-08-24. Old Tangent packages installed it to
# the system plugin directory; nothing ever removed it, so every DAW on the
# machine kept finding a stale build. Upgrading the app cleans it up.
rm -rf "/Library/Audio/Plug-Ins/VST3/Tangent.vst3" 2>/dev/null || true
exit 0
