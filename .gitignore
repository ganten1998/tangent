/target
/dist
*.app
.DS_Store

# python classifier cache
tests/golden/__pycache__/

# Keygen build output (the tool is a separate workspace under tools/)
tools/*/target/

# The retired VST3 crate's target outlives the crate. plugin/ is gone, but a
# checkout that built it keeps plugin/target through the merge that removed
# it: a SYMLINK out of Dropbox on the Mac, a build directory anywhere else.
# Unignored, it is an untracked file: `git status` and release.sh call the
# tree dirty, build-stamp.sh hashes it into the working tree so every build
# publishes as <HEAD>-dirty, and `git add -A` commits a link to a cache path
# on one particular Mac. NO trailing slash: `plugin/target/` matches a
# directory only, never the symlink.
plugin/target

# Installer staging. Kept out of the repo AND out of Dropbox by
# scripts/build-installer.sh, which stages in a temp dir; this catches the
# case where someone points it somewhere else.
#
# `build/*` and not `build/`, deliberately: git will not descend into an
# excluded DIRECTORY, so a `!build/macos/` negation under `build/` is silently
# powerless. Excluding the children instead is what makes the negation work.
build/*
# ...but NOT the macOS signing inputs, which are source.
#
# `scripts/build-macos.sh` fails fast if `build/macos/tangent.entitlements` is
# missing, so without this a fresh clone cannot build the app at all — and the
# file was untracked from the day it was written, because it happened to land
# under a directory ignored for a completely unrelated reason.
!build/macos/
/vendor/
.claude/

# Core dumps. FreeBSD writes <progname>.core beside the binary, and one of
# these is 87 MB of address space that no reader of this repository wants.
*.core
__pycache__/

# BSD sed backup droppings. On macOS `sed -i -e s/x/y/ file` does not mean
# "in place, with an expression" — it means "back the file up with suffix -e",
# so every such edit quietly leaves a stale `file-e` twin beside the original.
# Two of those got committed and then drifted out of date. Use `sed -i ''`
# here instead; this pattern catches the habit when it slips.
*-e

# The Keys bench writes its renders beside itself when it is given a bare
# name. They are measurement output, not source, and the default one is
# twelve seconds of audio that no clone wants.
tools/keysrig/*.wav
